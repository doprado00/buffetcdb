# ============================================================
#  .env.example — Modelo de configuração de ambiente
#  Copie este arquivo para .env e preencha com os valores reais.
#  NUNCA commite o arquivo .env no controle de versão.
# ============================================================

# --- Banco de Dados MySQL ---
DB_HOST=127.0.0.1
DB_USER=buffet_app          # Usuário dedicado criado via create_db_user.sql
DB_PASSWORD=TROQUE_PELA_SENHA_REAL
DB_NAME=buffet_elegance

# --- Segurança da Sessão / JWT ---
# Gere um valor forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SECRETA_FORTE
